# Copy to .env and fill in your values. .env is git-ignored — never commit real secrets.
# Every setting below has a built-in default (src/config.py); set only what differs.

PYTHONPATH=.

# Vector store (on Kubernetes: QDRANT_HOST=<service name>)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=munich_rag_children

# LLM (Mistral) — required by the agent; search-only scripts run without it.
# Left commented on purpose: if unset, the agent stops at startup with a clear error.
# MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
LLM_TIMEOUT_SECONDS=30

# Model caches — absolute paths only ("~" is not expanded here)
# MODEL_CACHE_DIR=/Users/<you>/.cache/munich-rag/models
# HF_HOME=/Users/<you>/.cache/huggingface